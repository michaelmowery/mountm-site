---
import { u } from '../lib/url';
const { p } = Astro.props;
const d = p.data;
---
<article class="feature">
  <div class="body">
    <div class="eyebrow">{d.category} · Featured</div>
    <h2 class="titled">{d.icon && <img class="app-icon" src={u(d.icon)} alt="" width="56" height="56" />}{d.name}</h2>
    <p class="lead">{d.summary}</p>
    <ul class="chips">{d.platforms.map((x: string) => <li>{x}</li>)}</ul>
    <div class="links">
      {d.url && <a class="btn btn-primary" href={d.url}>Try it on the web</a>}
      <a class="btn btn-ghost" href={u(`/work/${p.id}/`)}>Case study</a>
    </div>
    <p class="soon" style="margin-top:14px">App Store coming soon · Google Play coming soon</p>
  </div>
  <div class="shot"><img src={u(d.image)} alt={`${d.name} screenshot`} loading="lazy" /></div>
</article>
