---
import '../styles/global.css';
interface Props { title?: string; description?: string; }
const { title, description = 'Mount M Technologies designs and builds apps and websites. Based in Telluride, Colorado.' } = Astro.props;
const fullTitle = title ? `${title} · Mount M Technologies` : 'Mount M Technologies · Apps and websites, built in Telluride';
const path = Astro.url.pathname;
const nav = [ ['/work/', 'Work'], ['/services/', 'Services'], ['/about/', 'About'] ];
const email = 'mountmtech@gmail.com';
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
</head>
<body>
  <header class="site-header">
    <div class="wrap">
      <a class="logo" href="/" aria-label="Mount M Technologies home">
        <img class="light" src="/brand/lockup-light.svg" alt="Mount M Technologies" width="137" height="46" />
        <img class="dark" src="/brand/lockup-dark.svg" alt="Mount M Technologies" width="137" height="46" />
      </a>
      <nav aria-label="Main">
        <ul>
          {nav.map(([href, label]) => <li><a href={href} aria-current={path.startsWith(href) ? 'page' : undefined}>{label}</a></li>)}
          <li><a class="btn btn-primary" href={`mailto:${email}?subject=New%20project`}>Start a project</a></li>
        </ul>
      </nav>
    </div>
  </header>
  <main><slot /></main>
  <footer class="site-footer">
    <div class="wrap">
      <img class="light" src="/brand/lockup-light.svg" alt="Mount M Technologies" />
      <img class="dark" src="/brand/lockup-dark.svg" alt="Mount M Technologies" />
      <div>Mount M Technologies, LLC · Telluride, Colorado · <a href={`mailto:${email}`}>{email}</a></div>
      <div>© {new Date().getFullYear()}</div>
    </div>
  </footer>
</body>
</html>
